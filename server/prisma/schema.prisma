generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductSource {
  MANUAL
  IMPORT
  AWIN
  CJ
  SCRAPER
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  UNKNOWN
}

enum DealLevel {
  NONE
  GOOD
  HOT
  FEATURED
}

enum SyncFrequency {
  MANUAL
  HOURLY
  EVERY_6_HOURS
  DAILY
  WEEKLY
}

enum ImportSourceType {
  MANUAL
  JSON_FEED
  XML_FEED
  SCRAPER
  AWIN
  CJ
}

enum BrandSourceType {
  PLAYWRIGHT
  JSON_FEED
  XML_FEED
  MANUAL_IMPORT
}

enum BrandSourceStatus {
  ACTIVE
  DISABLED
  ERROR
}

enum ImportSourceStatus {
  ACTIVE
  DISABLED
  ERROR
}

enum ImportJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ImportLogLevel {
  INFO
  WARN
  ERROR
}

enum ScraperType {
  PLAYWRIGHT
  PUPPETEER
}

enum ScraperStatus {
  ACTIVE
  DISABLED
  ERROR
}

enum ScraperRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ConnectorRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ImportProductResultStatus {
  NEW
  UPDATED
  UNCHANGED
  FAILED
}

enum ImportFailureReason {
  MISSING_NAME
  MISSING_PRICE
  MISSING_IMAGE
  INVALID_URL
  INVALID_BRAND
  MISSING_BRAND
  MISSING_CATEGORY
  NORMALIZATION_ERROR
  RULE_REJECTED
  UPSERT_ERROR
  UNKNOWN
}

enum ScraperArtifactType {
  SCREENSHOT
  HTML_DUMP
  JSON_DUMP
}

enum SyncRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum AlertType {
  PRICE_DROP
  PRICE_INCREASE
  STOCK_CHANGE
  SYNC_FAILURE
  SCRAPER_FAILURE
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum IntegrationType {
  AWIN
  CJ
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum OrderStatus {
  PENDING
  PAYMENT_APPROVED
  PAID
  PROCESSING
  PURCHASED_FROM_SUPPLIER
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum ProcurementStatus {
  PURCHASE_REQUIRED
  PURCHASED_FROM_SUPPLIER
  RECEIVED_AT_WAREHOUSE
  READY_TO_SHIP
}

enum PaymentProvider {
  BANK_TRANSFER
  STRIPE
  PAYPAL
  MB_WAY
  MULTIBANCO
  MANUAL
}

enum PaymentKind {
  CHARGE
  REFUND
}

enum PaymentStatus {
  PAYMENT_PENDING_REVIEW
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  PAYMENT_PENDING
  AUTHORIZED
  PAID
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum AlertStatus {
  ACTIVE
  TRIGGERED
  EXPIRED
}

enum NotificationType {
  PRICE_ALERT
  ORDER_UPDATE
  PAYMENT_UPDATE
  PROCUREMENT_UPDATE
  SHIPPING_UPDATE
  ADMIN_OPERATIONAL
  MARKETING
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum NotificationChannelCode {
  EMAIL
  IN_APP
  ADMIN_OPERATIONAL
  SMS
  WHATSAPP
  TELEGRAM
  PUSH_NOTIFICATION
}

enum NotificationDeliveryState {
  PENDING
  QUEUED
  SENT
  DELIVERED
  OPENED
  FAILED
  SKIPPED
}

enum NotificationEventSource {
  AUTH
  ORDERS
  PAYMENTS
  PROCUREMENT
  SHIPPING
  IMPORTS
  MONITORING
  CONNECTORS
  SYSTEM
  MARKETING
}

enum NotificationCategory {
  ORDERS
  PAYMENTS
  SHIPPING
  PROCUREMENT
  SYSTEM
  MARKETING
  IMPORTS
  MONITORING
  CONNECTORS
  OPERATIONS
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditActorType {
  USER
  SYSTEM
  JOB
}

enum PricingTargetType {
  GLOBAL
  BRAND
  CATEGORY
}

enum CartType {
  GUEST
  USER
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LoyaltyOrderAwardStatus {
  PENDING
  AWARDED
  REVERSED
}

enum LoyaltyTransactionType {
  ORDER_EARN
  ORDER_REVERSAL
  REWARD_REDEMPTION
  MANUAL_ADJUSTMENT
}

enum LoyaltyRedemptionStatus {
  REDEEMED
  CANCELLED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponStatus {
  ACTIVE
  DISABLED
}

enum LoyaltyRewardType {
  PERCENTAGE_DISCOUNT
  FIXED_AMOUNT_DISCOUNT
  FREE_SHIPPING
  COUPON_TEMPLATE
}

model Role {
  id          String    @id @default(cuid())
  code        RoleCode  @unique
  name        String    @unique
  description String?
  users       User[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model User {
  id                  String                  @id @default(cuid())
  roleId              String
  email               String                  @unique
  passwordHash        String?
  fullName            String?
  firstName           String?
  lastName            String?
  phone               String?
  avatarUrl           String?
  avatarPublicId      String?
  preferredCurrency   String                  @default("EUR")
  status              UserStatus              @default(PENDING)
  emailVerified       Boolean                 @default(false)
  emailVerifiedAt     DateTime?
  stripeCustomerId    String?                 @unique
  lastLoginAt         DateTime?
  notificationPreference NotificationPreference?
  role                Role                    @relation(fields: [roleId], references: [id])
  refreshTokens       RefreshToken[]
  emailTokens         EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  wishlistItems       Wishlist[]
  addresses           Address[]
  customerAddresses   CustomerAddress[]
  carts               Cart[]
  orders              Order[]
  payments            Payment[]
  updatedExchangeRates ExchangeRate[]         @relation("ExchangeRateUpdatedBy")
  paymentAuditLogs    PaymentAuditLog[]
  notifications       Notification[]
  notificationEvents  NotificationEvent[]     @relation("NotificationEventActor")
  receivedNotificationEvents NotificationEvent[] @relation("NotificationEventTarget")
  notificationAudits  NotificationAudit[]
  notificationTemplates NotificationTemplate[] @relation("NotificationTemplateCreatedBy")
  notificationTemplateVersions NotificationTemplateVersion[] @relation("NotificationTemplateVersionCreatedBy")
  priceAlerts         PriceAlert[]
  reviews             Review[]
  auditLogs           AuditLog[]
  loyaltyAccount      LoyaltyAccount?
  loyaltyTransactions LoyaltyPointTransaction[] @relation("LoyaltyTransactionUser")
  loyaltyAdjustments  LoyaltyPointTransaction[] @relation("LoyaltyTransactionActor")
  rewardRedemptions   LoyaltyRewardRedemption[]
  loyaltyOrderAwards  LoyaltyOrderPointAward[]
  couponCartApplications  CouponCartApplication[]
  couponOrderApplications CouponOrderApplication[]
  issuedCoupons       Coupon[]                 @relation("IssuedCouponUser")
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([roleId])
  @@index([status])
}

model RefreshToken {
  id             String   @id @default(cuid())
  userId         String
  tokenHash      String   @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedByHash String?
  userAgent      String?
  ipAddress      String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Brand {
  id                String        @id @default(cuid())
  name              String        @unique
  slug              String        @unique
  logo              String?       @map("logoUrl")
  cloudinaryPublicId String?      @map("logoPublicId")
  description       String?
  website           String?
  isActive          Boolean       @default(true)
  marginPercent     Decimal?      @db.Decimal(5, 2)
  isLuxury          Boolean       @default(false)
  isFeatured        Boolean       @default(false)
  products          Product[]
  pricingRules      PricingRule[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([isActive])
}

model Category {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  description  String?
  icon         String?
  parentId     String?
  sortOrder    Int          @default(0)
  parent       Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]   @relation("CategoryTree")
  products     Product[]
  pricingRules PricingRule[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([name, parentId])
  @@index([parentId])
}

model Product {
  id              String         @id @default(cuid())
  brandId         String
  categoryId      String
  importSourceId  String?
  slug            String         @unique
  sourceProductId String?        @map("externalId")
  sku             String         @unique
  name            String         @map("title")
  description     String?
  oldPrice        Decimal?       @db.Decimal(10, 2) @map("originalPrice")
  outletPrice     Decimal?       @db.Decimal(10, 2)
  supplierPrice   Decimal?       @db.Decimal(10, 2)
  price           Decimal        @db.Decimal(10, 2) @map("finalPrice")
  customPrice     Decimal?       @db.Decimal(10, 2)
  profitAmount    Decimal?       @db.Decimal(10, 2)
  discountPercent Int?           @default(0)
  currency        String         @default("USD")
  marginPercent   Decimal?       @db.Decimal(5, 2)
  stock           Int            @default(0)
  stockStatus     StockStatus    @default(UNKNOWN)
  status          ProductStatus  @default(DRAFT)
  dealLevel       DealLevel      @default(NONE)
  contentHash     String?
  isFeatured      Boolean        @default(false)
  isTrending      Boolean        @default(false)
  useCustomPricing Boolean       @default(false)
  sourceType      ProductSource  @default(MANUAL) @map("source")
  sourceUrl       String?
  sourceStore     String?
  gender          String?
  material        String?
  sizes           String[]
  colors          String[]
  views           Int            @default(0)
  purchases       Int            @default(0)
  importedAt      DateTime?
  lastSyncedAt    DateTime?
  deletedAt       DateTime?
  brand           Brand          @relation(fields: [brandId], references: [id])
  category        Category       @relation(fields: [categoryId], references: [id])
  importSource    ImportSource?  @relation(fields: [importSourceId], references: [id])
  images          ProductImage[]
  variants        ProductVariant[]
  cartItems       CartItem[]
  priceHistory    PriceHistory[]
  priceChanges    PriceChange[]
  stockChanges    StockChange[]
  wishlistItems   Wishlist[]
  priceAlerts     PriceAlert[]
  orderItems      OrderItem[]
  reviews         Review[]
  importResults   ImportProductResult[]
  procurementTasks ProcurementTask[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([brandId])
  @@index([categoryId])
  @@index([importSourceId])
  @@index([status])
  @@index([sku])
  @@index([slug])
  @@index([dealLevel])
  @@index([contentHash])
  @@index([isFeatured])
  @@index([isTrending])
  @@index([useCustomPricing])
  @@index([deletedAt])
  @@index([stockStatus])
  @@index([lastSyncedAt])
}

model PriceChange {
  id            String    @id @default(cuid())
  productId     String
  oldPrice      Decimal?  @db.Decimal(10, 2)
  newPrice      Decimal   @db.Decimal(10, 2)
  changePercent Decimal   @db.Decimal(8, 2)
  detectedAt    DateTime  @default(now())
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([detectedAt])
}

model StockChange {
  id         String      @id @default(cuid())
  productId  String
  oldStatus  StockStatus
  newStatus  StockStatus
  detectedAt DateTime    @default(now())
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([detectedAt])
}

model ProductImage {
  id                 String   @id @default(cuid())
  productId          String
  imageUrl           String   @map("url")
  cloudinaryPublicId String?  @map("publicId")
  altText            String?
  sortOrder          Int      @default(0) @map("position")
  width              Int?
  height             Int?
  format             String?
  bytes              Int?
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([productId])
  @@unique([productId, sortOrder])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  size          String?
  color         String?
  stockQuantity Int      @default(0)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productId])
  @@unique([productId, size, color])
}

model PriceHistory {
  id              String     @id @default(cuid())
  productId       String
  importJobId     String?
  oldPrice        Decimal?   @db.Decimal(10, 2) @map("originalPrice")
  newPrice        Decimal    @db.Decimal(10, 2) @map("finalPrice")
  discountPercent Int?
  capturedAt      DateTime   @default(now())
  product         Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  importJob       ImportJob? @relation(fields: [importJobId], references: [id], onDelete: SetNull)

  @@index([productId, capturedAt])
  @@index([importJobId])
}

model Wishlist {
  id                 String   @id @default(cuid())
  userId             String
  productId          String
  priceAtAdd         Decimal? @db.Decimal(10, 2)
  originalPriceAtAdd Decimal? @db.Decimal(10, 2)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  name       String
  phone      String?
  street     String
  city       String
  state      String?
  postalCode String?
  country    String
  isDefault  Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model CustomerAddress {
  id               String   @id @default(cuid())
  userId           String?
  fullName         String
  phone            String?
  countryCode      String
  city             String
  postalCode       String
  addressLine1     String
  addressLine2     String?
  isDefaultShipping Boolean @default(false)
  isDefaultBilling Boolean @default(false)
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  country          Country  @relation(fields: [countryCode], references: [code])
  shippingOrders   Order[]  @relation("OrderShippingAddress")
  billingOrders    Order[]  @relation("OrderBillingAddress")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([countryCode])
}

model Cart {
  id                String       @id @default(cuid())
  userId            String?
  guestToken        String?      @unique
  type              CartType     @default(GUEST)
  currency          String       @default("EUR")
  displayCurrency   String       @default("EUR")
  countryCode       String
  subtotalAmount    Decimal      @db.Decimal(10, 2) @default(0)
  shippingAmount    Decimal      @db.Decimal(10, 2) @default(0)
  handlingAmount    Decimal      @db.Decimal(10, 2) @default(0)
  paymentFeeAmount  Decimal      @db.Decimal(10, 2) @default(0)
  taxAmount         Decimal      @db.Decimal(10, 2) @default(0)
  totalAmount       Decimal      @db.Decimal(10, 2) @default(0)
  pricingRuleId     String?
  shippingMethodId  String?
  expiresAt         DateTime?
  lastMergedAt      DateTime?
  user              User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  country           Country      @relation(fields: [countryCode], references: [code])
  pricingRule       PricingRule? @relation(fields: [pricingRuleId], references: [id], onDelete: SetNull)
  shippingMethod    ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  items             CartItem[]
  orders            Order[]
  couponApplication CouponCartApplication?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([userId])
  @@index([countryCode])
  @@index([pricingRuleId])
  @@index([shippingMethodId])
}

model CartItem {
  id               String   @id @default(cuid())
  cartId           String
  productId        String
  variantId        String?
  quantity         Int      @default(1)
  currency         String   @default("EUR")
  supplierCost     Decimal  @db.Decimal(10, 2)
  customerPaid     Decimal  @db.Decimal(10, 2)
  profitAmount     Decimal  @db.Decimal(10, 2)
  snapshotTitle    String
  snapshotBrand    String?
  snapshotImageUrl String?
  snapshotSourceUrl String?
  cart             Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

model Order {
  id                      String       @id @default(cuid())
  userId                  String
  cartId                  String?
  customerAddressId       String?
  billingAddressId        String?
  pricingRuleId           String?
  shippingMethodId        String?
  orderNumber             String       @unique
  status                  OrderStatus  @default(PENDING)
  customerName            String?
  customerEmail           String
  supplierSubtotal        Decimal      @db.Decimal(10, 2) @default(0)
  subtotal                Decimal      @db.Decimal(10, 2)
  shippingAmount          Decimal      @db.Decimal(10, 2)
  handlingAmount          Decimal      @db.Decimal(10, 2) @default(0)
  paymentFeeAmount        Decimal      @db.Decimal(10, 2) @default(0)
  taxAmount               Decimal      @db.Decimal(10, 2)
  profitAmount            Decimal      @db.Decimal(10, 2) @default(0)
  customerPaid            Decimal      @db.Decimal(10, 2) @default(0)
  totalAmount             Decimal      @db.Decimal(10, 2)
  currency                String       @default("EUR")
  displayCurrency         String       @default("EUR")
  shippingAddress         Json
  billingAddress          Json?
  businessSettingsSnapshot Json?
  pricingSnapshot         Json?
  exchangeRateSnapshot    Json?
  paymentProvider         PaymentProvider @default(MANUAL)
  paymentMethodLabel      String?
  trackingNumber          String?
  carrier                 String?
  trackingUrl             String?
  estimatedDeliveryDate   DateTime?
  shipmentNotes           String?
  notes                   String?
  internalNotes           String?
  refundedAmount          Decimal      @db.Decimal(10, 2) @default(0)
  totalWeightKg           Decimal      @db.Decimal(10, 2) @default(0)
  stripeCheckoutSessionId String?      @unique
  stripePaymentIntentId   String?      @unique
  paidAt                  DateTime?
  purchasedAt             DateTime?
  shippedAt               DateTime?
  deliveredAt             DateTime?
  cancelledAt             DateTime?
  refundedAt              DateTime?
  user                    User         @relation(fields: [userId], references: [id])
  cart                    Cart?        @relation(fields: [cartId], references: [id], onDelete: SetNull)
  customerAddress         CustomerAddress? @relation("OrderShippingAddress", fields: [customerAddressId], references: [id], onDelete: SetNull)
  billingAddressRef       CustomerAddress? @relation("OrderBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  pricingRule             PricingRule? @relation(fields: [pricingRuleId], references: [id], onDelete: SetNull)
  shippingMethod          ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  items                   OrderItem[]
  procurementTasks        ProcurementTask[]
  payments                Payment[]
  paymentTransactions     PaymentTransaction[]
  paymentWebhooks         PaymentWebhook[]
  paymentRefunds          PaymentRefund[]
  loyaltyAward            LoyaltyOrderPointAward?
  loyaltyTransactions     LoyaltyPointTransaction[]
  couponApplication       CouponOrderApplication?
  notifications           Notification[]
  notificationEvents      NotificationEvent[]
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@index([userId])
  @@index([cartId])
  @@index([customerAddressId])
  @@index([billingAddressId])
  @@index([pricingRuleId])
  @@index([shippingMethodId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  productId  String?
  title      String
  brandName  String?
  size       String?
  color      String?
  quantity   Int
  supplierCost Decimal @db.Decimal(10, 2) @default(0)
  customerPaid Decimal @db.Decimal(10, 2) @default(0)
  profitAmount Decimal @db.Decimal(10, 2) @default(0)
  unitPrice  Decimal  @db.Decimal(10, 2)
  totalPrice Decimal  @db.Decimal(10, 2)
  imageUrl   String?
  sourceUrl  String?
  sourceStore String?
  currency   String   @default("EUR")
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  procurementTask ProcurementTask?
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model ProcurementTask {
  id                   String            @id @default(cuid())
  orderId              String
  orderItemId          String            @unique
  productId            String?
  brandSourceId        String?
  status               ProcurementStatus @default(PURCHASE_REQUIRED)
  supplierName         String?
  sourceWebsite        String?
  productUrl           String?
  quantity             Int
  currency             String            @default("EUR")
  supplierPrice        Decimal           @db.Decimal(10, 2) @default(0)
  shippingToPortugal   Decimal           @db.Decimal(10, 2) @default(0)
  customsCost          Decimal           @db.Decimal(10, 2) @default(0)
  totalProcurementCost Decimal           @db.Decimal(10, 2) @default(0)
  expectedProfit       Decimal           @db.Decimal(10, 2) @default(0)
  realProfit           Decimal           @db.Decimal(10, 2) @default(0)
  actualMarginPercent  Decimal           @db.Decimal(8, 2) @default(0)
  notes                String?
  purchasedAt          DateTime?
  receivedAtWarehouseAt DateTime?
  readyToShipAt        DateTime?
  order                Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem            OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product              Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  brandSource          BrandSource?      @relation(fields: [brandSourceId], references: [id], onDelete: SetNull)
  notificationEvents   NotificationEvent[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([brandSourceId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id                      String          @id @default(cuid())
  userId                  String
  orderId                 String?
  providerConfigurationId String?
  provider                PaymentProvider @default(STRIPE)
  kind                    PaymentKind     @default(CHARGE)
  status                  PaymentStatus   @default(PENDING)
  currency                String          @default("EUR")
  displayCurrency         String          @default("EUR")
  amount                  Decimal         @db.Decimal(10, 2)
  exchangeRate            Decimal?        @db.Decimal(18, 6)
  paymentReference        String?
  stripePaymentIntentId   String?
  stripeCheckoutSessionId String?
  stripeChargeId          String?
  stripeRefundId          String?
  receiptUrl              String?
  receiptPublicId         String?
  receiptFileName         String?
  receiptMimeType         String?
  receiptUploadedAt       DateTime?
  customerNotes           String?
  internalNotes           String?
  reviewRequestedAt       DateTime?
  approvedAt              DateTime?
  rejectedAt              DateTime?
  metadata                Json?
  processedAt             DateTime?
  user                    User            @relation(fields: [userId], references: [id])
  order                   Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  providerConfiguration   PaymentProviderConfig? @relation(fields: [providerConfigurationId], references: [id], onDelete: SetNull)
  transactions            PaymentTransaction[]
  webhooks                PaymentWebhook[]
  refunds                 PaymentRefund[]
  auditLogs               PaymentAuditLog[]
  notifications           Notification[]
  notificationEvents      NotificationEvent[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([userId])
  @@index([orderId])
  @@index([providerConfigurationId])
  @@index([status])
  @@index([kind])
}

model PaymentProviderConfig {
