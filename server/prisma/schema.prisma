  order                   Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  providerConfiguration   PaymentProviderConfig? @relation(fields: [providerConfigurationId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([orderId])
  @@index([providerConfigurationId])
  @@index([provider, status])
}

model PaymentRefund {
  id                      String          @id @default(cuid())
  paymentId               String
  orderId                 String?
  transactionId           String?
