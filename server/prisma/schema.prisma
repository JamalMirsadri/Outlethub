  message    String
  isRead     Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@index([type])
  @@index([severity])
  @@index([isRead])
  @@index([createdAt])
}

model Review {
  id           String       @id @default(cuid())
  productId    String
  userId       String?
  rating       Int
  title        String?
  comment      String
  reviewerName String?
  isVerified   Boolean      @default(false)
  isFeatured   Boolean      @default(false)
  status       ReviewStatus @default(PENDING)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([productId])
  @@index([userId])
  @@index([status])
}

model Notification {
  id           String             @id @default(cuid())
  userId       String
  eventId      String?
  orderId      String?
  paymentId    String?
  priceAlertId String?
  channelCode  NotificationChannelCode @default(IN_APP)
  category     NotificationCategory    @default(SYSTEM)
  priority     NotificationPriority    @default(MEDIUM)
  type         NotificationType
  status       NotificationStatus @default(UNREAD)
  title        String
  message      String
  entityType   String?
  entityId     String?
  data         Json?
  readAt       DateTime?
  archivedAt   DateTime?
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  event        NotificationEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  order        Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payment      Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  priceAlert   PriceAlert?        @relation(fields: [priceAlertId], references: [id], onDelete: SetNull)
  deliveries   NotificationDelivery[]
  audits       NotificationAudit[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([userId, status])
  @@index([type])
  @@index([eventId])
  @@index([category, createdAt])
  @@index([entityType, entityId])
}

model NotificationPreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  orderNotifications    Boolean  @default(true)
  paymentNotifications  Boolean  @default(true)
  shippingNotifications Boolean  @default(true)
  marketingEmails       Boolean  @default(false)
  systemNotifications   Boolean  @default(true)
  channelSettings       Json?
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model NotificationChannel {
  code                NotificationChannelCode @id
  displayName         String
  isActive            Boolean                 @default(true)
  queueName           String
  supportsOpenTracking Boolean                @default(false)
  supportsRetries     Boolean                 @default(true)
  settings            Json?
  templates           NotificationTemplate[]
  deliveries          NotificationDelivery[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
}

model NotificationEvent {
  id                String                  @id @default(cuid())
  eventKey          String                  @unique
  eventName         String
  eventSource       NotificationEventSource
  category          NotificationCategory
  priority          NotificationPriority    @default(MEDIUM)
  actorUserId       String?
  targetUserId      String?
  orderId           String?
  paymentId         String?
  procurementTaskId String?
  entityType        String?
  entityId          String?
  title             String?
  message           String?
  metadata          Json?
  occurredAt        DateTime                @default(now())
  actorUser         User?                   @relation("NotificationEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser        User?                   @relation("NotificationEventTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  order             Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payment           Payment?                @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  procurementTask   ProcurementTask?        @relation(fields: [procurementTaskId], references: [id], onDelete: SetNull)
  notifications     Notification[]
  deliveries        NotificationDelivery[]
  audits            NotificationAudit[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([targetUserId, occurredAt])
  @@index([eventSource, occurredAt])
  @@index([category, occurredAt])
  @@index([orderId])
  @@index([paymentId])
  @@index([procurementTaskId])
}

model NotificationTemplate {
  id            String                  @id @default(cuid())
  key           String
  name          String
  channelCode   NotificationChannelCode
  category      NotificationCategory
  subjectTemplate String
  htmlTemplate  String
  textTemplate  String
  variablesSchema Json?
  samplePayload Json?
  description   String?
  version       Int                     @default(1)
  isActive      Boolean                 @default(true)
  createdByUserId String?
  channel       NotificationChannel     @relation(fields: [channelCode], references: [code], onDelete: Restrict)
  createdByUser User?                   @relation("NotificationTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  versions      NotificationTemplateVersion[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([key, channelCode])
  @@index([category, isActive])
}

model NotificationTemplateVersion {
  id              String                  @id @default(cuid())
  templateId      String
  version         Int
  subjectTemplate String
  htmlTemplate    String
  textTemplate    String
  samplePayload   Json?
  variablesSchema Json?
  createdByUserId String?
  changeNotes     String?
  template        NotificationTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdByUser   User?                   @relation("NotificationTemplateVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime                @default(now())

  @@unique([templateId, version])
  @@index([templateId, createdAt])
}

model NotificationDelivery {
  id                String                    @id @default(cuid())
  eventId           String
  notificationId    String?
  channelCode       NotificationChannelCode
  state             NotificationDeliveryState @default(PENDING)
  recipient         String?
  provider          String?
  providerMessageId String?
  renderedSubject   String?
  renderedBody      String?
  providerResponse  Json?
  failureReason     String?
  retryCount        Int                       @default(0)
  openTimestamp     DateTime?
  queuedAt          DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  failedAt          DateTime?
  skippedAt         DateTime?
  metadata          Json?
  event             NotificationEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  notification      Notification?            @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  channel           NotificationChannel      @relation(fields: [channelCode], references: [code], onDelete: Restrict)
  audits            NotificationAudit[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([eventId, channelCode])
  @@index([notificationId])
  @@index([state, createdAt])
}

model NotificationAudit {
  id            String            @id @default(cuid())
  eventId       String?
  notificationId String?
  deliveryId    String?
  actorUserId   String?
  action        String
  eventSource   NotificationEventSource?
  metadata      Json?
  event         NotificationEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  notification  Notification?    @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  delivery      NotificationDelivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  actorUser     User?            @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())

  @@index([eventId])
  @@index([notificationId])
  @@index([deliveryId])
  @@index([actorUserId])
  @@index([action, createdAt])
}

model AuditLog {
  id          String         @id @default(cuid())
  actorUserId String?
  actorType   AuditActorType @default(USER)
  action      String
  entityType  String
  entityId    String?
  importJobId String?
  scraperRunId String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  actorUser   User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  importJob   ImportJob?     @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  scraperRun  ScraperRun?    @relation(fields: [scraperRunId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())

  @@index([actorUserId])
  @@index([scraperRunId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LoyaltyAccount {
  id                String                    @id @default(cuid())
  userId            String                    @unique
  membershipLevelId String?
  currentPoints     Int                       @default(0)
  totalEarnedPoints Int                       @default(0)
  totalSpentPoints  Int                       @default(0)
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipLevel   LoyaltyMembershipLevel?   @relation(fields: [membershipLevelId], references: [id], onDelete: SetNull)
  transactions      LoyaltyPointTransaction[]
  rewardRedemptions LoyaltyRewardRedemption[]
  orderAwards       LoyaltyOrderPointAward[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([membershipLevelId])
  @@index([currentPoints])
}

model LoyaltyPointRule {
  id          String                  @id @default(cuid())
  name        String
  spendAmount Decimal                 @db.Decimal(10, 2)
  pointsAwarded Int
  currency    String                  @default("EUR")
  isActive    Boolean                 @default(true)
  isDefault   Boolean                 @default(false)
  notes       String?
  orderAwards LoyaltyOrderPointAward[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([isActive, isDefault])
}

model LoyaltyMembershipLevel {
  id          String                  @id @default(cuid())
  title       String                  @unique
  slug        String                  @unique
  minPoints   Int
  color       String                  @default("#B08D57")
  icon        String?
  benefits    Json?
  sortOrder   Int                     @default(0)
  isActive    Boolean                 @default(true)
  accounts    LoyaltyAccount[]
  rewards     LoyaltyReward[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([minPoints, isActive])
  @@index([sortOrder])
}

model LoyaltyReward {
  id                   String                    @id @default(cuid())
  title                String
  slug                 String                    @unique
  description          String?
  pointsCost           Int
  rewardType           LoyaltyRewardType         @default(PERCENTAGE_DISCOUNT)
  startsAt             DateTime?
  endsAt               DateTime?
  minMembershipLevelId String?
  couponTemplateId     String?
  couponPercentage     Decimal?                  @db.Decimal(5, 2)
  couponFixedAmount    Decimal?                  @db.Decimal(10, 2)
  couponMinimumOrderAmount Decimal?              @db.Decimal(10, 2)
  couponMaximumDiscountAmount Decimal?           @db.Decimal(10, 2)
  couponDurationDays   Int?
  couponCodePrefix     String?
  color                String?
  icon                 String?
  benefits             Json?
  stockLimit           Int?
  isActive             Boolean                   @default(true)
  sortOrder            Int                       @default(0)
  minMembershipLevel   LoyaltyMembershipLevel?   @relation(fields: [minMembershipLevelId], references: [id], onDelete: SetNull)
  couponTemplate       Coupon?                   @relation("LoyaltyRewardCouponTemplate", fields: [couponTemplateId], references: [id], onDelete: SetNull)
  redemptions          LoyaltyRewardRedemption[]
  pointTransactions    LoyaltyPointTransaction[]
  generatedCoupons     Coupon[]                  @relation("CouponRewardSource")
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([minMembershipLevelId])
  @@index([couponTemplateId])
  @@index([isActive, sortOrder])
}

model LoyaltyRewardRedemption {
  id           String                  @id @default(cuid())
  accountId    String
  userId       String
  rewardId     String
  pointsSpent  Int
  status       LoyaltyRedemptionStatus @default(REDEEMED)
  notes        String?
  metadata     Json?
  redeemedAt   DateTime                @default(now())
  cancelledAt  DateTime?
  account      LoyaltyAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward       LoyaltyReward           @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  transactions LoyaltyPointTransaction[]
  issuedCoupon Coupon?                 @relation("RewardRedemptionIssuedCoupon")
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([accountId, redeemedAt])
  @@index([userId, redeemedAt])
  @@index([rewardId])
  @@index([status])
}

model LoyaltyPointTransaction {
  id            String                 @id @default(cuid())
  accountId     String
  userId        String
  orderId       String?
  rewardId      String?
  redemptionId  String?
  actorUserId   String?
  type          LoyaltyTransactionType
  pointsDelta   Int
  balanceAfter  Int
  description   String
  metadata      Json?
  account       LoyaltyAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user          User                   @relation("LoyaltyTransactionUser", fields: [userId], references: [id], onDelete: Cascade)
  order         Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  reward        LoyaltyReward?         @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  redemption    LoyaltyRewardRedemption? @relation(fields: [redemptionId], references: [id], onDelete: SetNull)
  actorUser     User?                  @relation("LoyaltyTransactionActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime               @default(now())

  @@index([accountId, createdAt])
  @@index([userId, createdAt])
  @@index([orderId])
  @@index([rewardId])
  @@index([redemptionId])
  @@index([actorUserId])
  @@index([type, createdAt])
}

model LoyaltyOrderPointAward {
  id           String                   @id @default(cuid())
  orderId      String                   @unique
  accountId    String
  userId       String
  pointRuleId  String?
  awardedPoints Int
  spendAmount  Decimal                  @db.Decimal(10, 2)
  status       LoyaltyOrderAwardStatus  @default(PENDING)
  metadata     Json?
  awardedAt    DateTime?
  reversedAt   DateTime?
  order        Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  account      LoyaltyAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointRule    LoyaltyPointRule?        @relation(fields: [pointRuleId], references: [id], onDelete: SetNull)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([accountId])
  @@index([userId])
  @@index([pointRuleId])
  @@index([status])
}

model Coupon {
  id                        String                 @id @default(cuid())
  code                      String                 @unique
  description               String?
  discountType              CouponDiscountType
  percentage                Decimal?               @db.Decimal(5, 2)
  fixedAmount               Decimal?               @db.Decimal(10, 2)
  freeShipping              Boolean                @default(false)
  minimumOrderAmount        Decimal?               @db.Decimal(10, 2)
  maximumDiscountAmount     Decimal?               @db.Decimal(10, 2)
  usageLimit                Int?
  usagePerUser              Int?
  startsAt                  DateTime?
  endsAt                    DateTime?
  allowedProductIds         String[]               @default([])
  allowedCategoryIds        String[]               @default([])
  allowedBrandIds           String[]               @default([])
  excludedProductIds        String[]               @default([])
  excludedCategoryIds       String[]               @default([])
  excludedBrandIds          String[]               @default([])
  allowedMembershipLevelIds String[]               @default([])
  status                    CouponStatus           @default(ACTIVE)
  issuedToUserId            String?
  sourceRewardId            String?
  sourceRedemptionId        String?                @unique
  isGeneratedRewardCoupon   Boolean                @default(false)
  cartApplications          CouponCartApplication[]
  orderApplications         CouponOrderApplication[]
  issuedToUser              User?                  @relation("IssuedCouponUser", fields: [issuedToUserId], references: [id], onDelete: SetNull)
  sourceReward              LoyaltyReward?         @relation("CouponRewardSource", fields: [sourceRewardId], references: [id], onDelete: SetNull)
  rewardRedemption          LoyaltyRewardRedemption? @relation("RewardRedemptionIssuedCoupon", fields: [sourceRedemptionId], references: [id], onDelete: SetNull)
  rewardTemplateFor         LoyaltyReward[]        @relation("LoyaltyRewardCouponTemplate")
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
  @@index([issuedToUserId])
  @@index([sourceRewardId])
}

model CouponCartApplication {
  id         String   @id @default(cuid())
  couponId    String?
  cartId      String   @unique
  userId      String?
  codeSnapshot String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  coupon      Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  cart        Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderApplications CouponOrderApplication[]

  @@index([couponId])
  @@index([userId])
}

model CouponOrderApplication {
  id                     String              @id @default(cuid())
  couponId               String?
  orderId                String              @unique
  cartApplicationId      String?
  userId                 String
  codeSnapshot           String
  descriptionSnapshot    String?
  discountType           CouponDiscountType
  percentageSnapshot     Decimal?            @db.Decimal(5, 2)
  fixedAmountSnapshot    Decimal?            @db.Decimal(10, 2)
  freeShippingSnapshot   Boolean             @default(false)
  discountAmount         Decimal             @db.Decimal(10, 2) @default(0)
  shippingDiscountAmount Decimal             @db.Decimal(10, 2) @default(0)
  totalSavingsAmount     Decimal             @db.Decimal(10, 2) @default(0)
  qualifiedSubtotal      Decimal             @db.Decimal(10, 2) @default(0)
  metadata               Json?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  coupon                 Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  order                  Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cartApplication        CouponCartApplication? @relation(fields: [cartApplicationId], references: [id], onDelete: SetNull)
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@index([cartApplicationId])
  @@index([createdAt])
}
