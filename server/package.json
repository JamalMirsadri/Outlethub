{
  "name": "@luxe-outlet-hub/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/build-package.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "verify:web-assets": "node scripts/verify-web-assets.mjs",
    "prestart": "npm run prepare:runtime && npm run verify:web-assets",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test:catalog": "tsx --test tests/catalog.service.test.ts",
    "test:imports": "tsx --test tests/imports.service.test.ts",
    "test:monitoring": "tsx --test tests/monitoring.service.test.ts",
    "test:scrapers": "tsx --test tests/scrapers.service.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.56.8",
    "cheerio": "^1.2.0",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^7.0.5",
    "playwright": "^1.54.1",
    "stripe": "^18.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.5",
    "prisma": "^6.10.1",
    "tsx": "^4.20.1",
    "typescript": "^5.8.2"
  }
}
