{
  "name": "luxe-outlet-hub",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace client",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "dev:services": "powershell -ExecutionPolicy Bypass -File ./scripts/dev/start-local-services.ps1",
    "dev:postgres": "powershell -ExecutionPolicy Bypass -File ./scripts/dev/start-postgres.ps1",
    "dev:redis": "powershell -ExecutionPolicy Bypass -File ./scripts/dev/start-redis.ps1",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "build:client": "npm run build --workspace client",
    "build:server": "npm run build --workspace server",
    "typecheck": "npm run typecheck --workspace client && npm run typecheck --workspace server",
    "lint": "npm run lint --workspace client && npm run lint --workspace server",
    "prisma:generate": "npm run prisma:generate --workspace server",
    "prisma:migrate": "npm run prisma:migrate --workspace server",
    "prisma:seed": "npm run prisma:seed --workspace server"
  }
}
